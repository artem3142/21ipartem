
TAX_RATE = 0.13

income = float(input("Введите годовой доход: "))

tax_amount = income * TAX_RATE
take_home_pay = income - tax_amount

print(f"Общая сумма дохода: {income:,.2f} руб.")
print(f"Сумма рассчитанного налога: {tax_amount:,.2f} руб.")
print(f"Сумма «на руки» после вычета налога: {take_home_pay:,.2f} руб.")
